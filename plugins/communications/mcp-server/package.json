{
  "name": "@mbg/imessage-fast-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Native iMessage MCP server for the mbg-library communications plugin. No BlueBubbles required.",
  "bin": {
    "imessage-fast-mcp": "dist/index.cjs"
  },
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=24"
  }
}
