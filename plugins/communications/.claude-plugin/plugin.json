{
  "name": "communications",
  "displayName": "Communications",
  "version": "2.1.0",
  "description": "A complete AI communications toolkit for busy professionals. Triage and organize overflowing inboxes, draft professional emails in your voice, walk into every meeting prepared, extract action items from transcripts, build negotiation strategies on demand, and automatically sync your PLAUD voice recordings to your Cloud Brain. Designed to run as an Executive Inbox Agent on a daily schedule — so your communications are handled before you even open your laptop.",
  "author": {
    "name": "MyBusinessGenie"
  },
  "requires_memory": true,
  "memory_provider": "cloud-brain",
  "memory_paths": {
    "preferences": "brain/preferences/comm-preferences.md",
    "triage_logs": "brain/communications/triage/",
    "drafts": "brain/communications/drafts/",
    "meeting_notes": "brain/communications/meetings/"
  },
  "industries": [
    "all"
  ],
  "keywords": [
    "email",
    "inbox",
    "communications",
    "meeting",
    "triage",
    "drafting",
    "negotiation",
    "executive assistant",
    "inbox zero",
    "imessage",
    "imessage-fast",
    "plaud",
    "voice notes",
    "voice recording",
    "productivity"
  ],
  "integrates_with": [
    { "plugin": "business-operations", "type": "see-also" },
    { "plugin": "person-brief", "type": "see-also" },
    { "plugin": "prospecting", "type": "see-also" },
    { "plugin": "prosumer-ops", "type": "see-also" },
    { "plugin": "zoom-meetings", "type": "see-also" }
  ],
  "mcpServers": {
    "imessage-fast": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/index.js"]
    }
  }
}
